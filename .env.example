# Только для daemon; не передавайте токен клиенту.
# Daemon читает переменные из окружения при старте и завершается с ошибкой
# до создания сокета, если что-то из трёх кредов отсутствует или пусто.
# Встроенного .env-парсера нет; для systemd используйте EnvironmentFile.
YANDEX_X_TOKEN=
# OAuth-креды клиента Yandex Music (обязательны для обмена x-token на Music token).
# Указывайте только в конфигурации daemon; CLI их не получает.
YANDEX_MUSIC_CLIENT_ID=
YANDEX_MUSIC_CLIENT_SECRET=
# Ручной режим станции: применяется только если заданы ВСЕ четыре переменные.
# Иначе станция ищется по mDNS (_yandexio._tcp.local.), а YANDEX_DEVICE_ID
# используется для выбора нужной (обязателен, если найдено несколько станций).
YANDEX_DEVICE_ID=
YANDEX_PLATFORM=
YANDEX_STATION_HOST=
# Порт 1–65535; 0 или нечисловое значение — ошибка "YANDEX_STATION_PORT must be a valid port".
YANDEX_STATION_PORT=
# По умолчанию: $XDG_RUNTIME_DIR/yandex-stationd.sock
SOCKET_PATH=
